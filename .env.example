# Copy to .env.local and fill in.

# AMC vendor API key. Leave empty to use built-in mock data.
AMC_API_KEY=
# "mock" or "live". Defaults to live when AMC_API_KEY is set, otherwise mock.
AMC_MODE=

# SQLite file path
DATABASE_URL=./data/app.db

# Required for /api/cron/poll (external/hosted cron triggers)
CRON_SECRET=

# Set to 1 to disable the built-in every-minute scheduler (e.g. on serverless hosts)
DISABLE_SCHEDULER=
